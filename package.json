{
  "name": "okashina-tankentai",
  "version": "0.1.0",
  "description": "家族で１日５分。冒険と絵日記と宝物のスマホゲーム。",
  "scripts": {
    "build": "node build.mjs",
    "dev": "npm run build && wrangler dev --ip 0.0.0.0",
    "test": "node --test tests/*.test.js",
    "db:local": "wrangler d1 migrations apply DB --local",
    "db:remote": "wrangler d1 migrations apply DB --remote",
    "deploy": "npm run build && wrangler deploy",
    "test:pwa": "node tests/pwa.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "private": true,
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "esbuild": "^0.28.2",
    "miniflare": "^5.20261110.0-beta",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "wrangler": "^4.160.0"
  },
  "dependencies": {
    "jsqr": "^1.4.0",
    "qrcode": "^1.5.4"
  }
}
